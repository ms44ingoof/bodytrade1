{
  "schemaVersion": 1,
  "id": "bodytrade",
  "version": "${version}",
  "name": "Body Trade",
  "description": "Меняй части тела на ресурсы.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.bodytrade.BodyTradeMod"
    ],
    "client": [
      "com.example.bodytrade.client.BodyTradeClient"
    ],
    "voicechat": [
      "com.example.bodytrade.voice.BodyVoicechatPlugin"
    ]
  },
  "mixins": [
    {
      "config": "bodytrade.mixins.json",
      "environment": "client"
    },
    "bodytrade.common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": "*"
  }
}